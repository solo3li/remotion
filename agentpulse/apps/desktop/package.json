{
  "name": "agentpulse-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "pack": "node scripts/build-web.mjs && node scripts/bundle-runtime.mjs && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.agentpulse.desktop",
    "productName": "AgentPulse",
    "files": [
      "main.cjs",
      "build-icon.png"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "web"
      },
      {
        "from": "../../services/api",
        "to": "api",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!tests/**",
          "!*.ini",
          "!README.md"
        ]
      },
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "icon": "build-icon.png"
    },
    "dmg": {
      "title": "AgentPulse"
    }
  }
}
